<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:section title="Bitwarden Credentials Provider">
        <f:entry title="Bitwarden Server URL" field="serverUrl">
            <f:textbox />
        </f:entry>
        <f:entry title="Bitwarden API Key Credential" field="apiCredentialId">
            <c:select />
        </f:entry>
        <f:entry title="Bitwarden Master Password Credential" field="masterPasswordCredentialId">
            <c:select />
        </f:entry>
        <f:entry title="Item List Cache Duration (minutes)" field="cacheDuration">
            <f:number default="5" min="1" />
        </f:entry>
        <f:advanced title="Plugin Actions">
            <f:entry title="Bitwarden CLI Management" field="cliManagement">
                <f:block>
                    <f:helpArea />
                    <f:validateButton
                            title="Check Version"
                            progress="Checking..."
                            method="checkCliVersion" />
                    <f:validateButton
                            title="Download Latest"
                            progress="Downloading..."
                            method="forceUpdateCli" />
                </f:block>
            </f:entry>
            <f:entry title="Force Cache Refresh" field="refreshCache">
                <f:block>
                    <f:helpArea />
                    <f:validateButton
                            title="Refresh Now"
                            progress="Refreshing..."
                            method="refreshCache"
                            with="serverUrl,apiCredentialId,masterPasswordCredentialId" />
                </f:block>
            </f:entry>
        </f:advanced>
    </f:section>
</j:jelly>