<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:section title="${%config.title}">
        <f:entry title="${%field.serverUrl}" field="serverUrl">
            <f:textbox />
        </f:entry>
        <f:entry title="${%field.apiCredentialId}" field="apiCredentialId">
            <c:select />
        </f:entry>
        <f:entry title="${%field.masterPasswordCredentialId}" field="masterPasswordCredentialId">
            <c:select />
        </f:entry>
        <f:advanced title="${%section.advancedActions}">
            <f:entry title="${%field.cacheDuration}" field="cacheDuration">
                <f:number min="1" />
            </f:entry>
            <f:entry title="${%field.fileCredentialSuffixes}" field="fileCredentialSuffixes">
                <f:textbox />
            </f:entry>
            <f:entry title="${%field.cliExecutablePath}" field="cliExecutablePath">
                <f:textbox />
            </f:entry>
            <f:entry title="${%field.cliManagement}" field="cliManagement">
                <f:helpArea />
                <f:validateButton
                        title="${%button.checkCliVersion}"
                        progress="${%button.checking}"
                        method="checkCliVersion"
                />
                <f:validateButton
                        title="${%button.updateCli}"
                        progress="${%button.updating}"
                        method="updateCli"
                />
            </f:entry>
            <f:entry title="${%field.vaultSynchronization}" field="vaultSynchronization">
                <f:helpArea />
                <f:validateButton
                        title="${%button.syncVault}"
                        progress="${%button.syncing}"
                        method="syncVault"
                />
            </f:entry>
            <f:entry title="${%field.sessionStatus}" field="sessionStatus">
                <f:helpArea />
                <f:validateButton
                        title="${%button.verifySession}"
                        progress="${%button.verifying}"
                        method="verifySession"
                />
            </f:entry>
        </f:advanced>
    </f:section>
</j:jelly>